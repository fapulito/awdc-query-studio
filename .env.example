# Flask Configuration
FLASK_ENV=production
SECRET_KEY=405d79dbc205bc019772e6cd777ebc9cab110696af19994acf6297f89dc53f22

# LLM Service Configuration
LLM_PROVIDER=gemini                    # "openai" or "gemini"
LLM_API_KEY=your-api-key-here          # Get Gemini key from https://makersuite.google.com/app/apikey
LLM_MODEL=gemini-pro                   # For OpenAI: gpt-4o, gpt-3.5-turbo | For Gemini: gemini-pro, gemini-1.5-flash
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# Oracle Database Configuration
ORACLE_CONNECTION_STRING=your-oracle-host:1521/service_name
ORACLE_USER=your-database-username
ORACLE_PASSWORD=your-database-password
ORACLE_ALLOWED_VIEWS=view1,view2,view3

# PDF Connector Configuration
PDF_STORAGE_PATH=/path/to/pdf/storage
PDF_INDEX_FILE=./pdf_index.json
PDF_INDEX_REFRESH_INTERVAL=3600
PDF_MAX_SEARCH_RESULTS=10

# MCP Server Configuration (if deployed separately)
MCP_ORACLE_ENDPOINT=http://localhost:5001
MCP_PDF_ENDPOINT=http://localhost:5002
MCP_YUGABYTE_ENDPOINT=http://localhost:5003

# ============================================================================
# YugabyteDB Configuration
# ============================================================================
# Yugabyte Aeon (cloud) connection — TLS required (sslmode=require)
# Use a READ-ONLY database user; never the superuser or a write-capable role.
# Table names are schema-qualified: awdc.laas_population_data
YUGABYTE_HOST=your-cluster.us-east-1.yugabyte.cloud
YUGABYTE_PORT=5433
YUGABYTE_DBNAME=yugabyte
YUGABYTE_USER=your_readonly_user
YUGABYTE_PASSWORD=your_password_here
YUGABYTE_SSLMODE=require
# Comma-separated list of schema-qualified tables the chatbot may query.
# Start with a single table for demo; add others after validation.
YUGABYTE_ALLOWED_TABLES=awdc.laas_population_data

# Application Settings
SESSION_TIMEOUT=1800
MAX_CONVERSATION_HISTORY=50
QUERY_TIMEOUT=5
MAX_RESULT_SIZE=1000
# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/chatbot.log
LOG_JSON=false

# Serverless Optimization (Requirements: 2.4, 2.5)
CONNECTION_CACHE_TTL=300
INIT_CACHE_TTL=300
ENABLE_LAZY_LOADING=true

# ============================================================================
# OAuth2 Authentication Configuration (REQUIRED - at least one provider)
# ============================================================================
# General OAuth2 Settings
OAUTH2_DEFAULT_PROVIDER=google         # Default provider if only one configured
OAUTH2_CALLBACK_URL_BASE=http://localhost:5000  # Change to production URL when deploying
OAUTH2_TOKEN_EXPIRATION=3600           # Token expiration in seconds (1 hour)

# OAuth2 Provider Credentials - Google (Recommended for quick setup)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:5000/callback/google (or your production URL)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 Provider Credentials - GitHub (Optional)
# Get credentials from: https://github.com/settings/developers
# Callback URL: http://localhost:5000/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth2 Provider Credentials - Facebook (Optional)
# Get credentials from: https://developers.facebook.com/apps
# Callback URL: http://localhost:5000/callback/facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# OAuth2 Provider Credentials - LinkedIn (Optional)
# Get credentials from: https://www.linkedin.com/developers/apps
# Callback URL: http://localhost:5000/callback/linkedin
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# OAuth2 Provider Credentials - Auth0 (Optional)
# Get credentials from: https://manage.auth0.com/dashboard
# Callback URL: http://localhost:5000/callback/auth0
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_DOMAIN=your-domain.auth0.com

# Application Metadata and Branding (Requirements: 7.1, 7.2, 7.3, 7.4, 7.5)
# Application Information
APP_NAME=Chatbot Assistant
APP_DESCRIPTION=AI-powered chatbot with MCP integration for Oracle APEX and PDF documents
APP_URL=http://localhost:5000
APP_TAGLINE=Ask questions about your data

# Social Media Metadata
# Open Graph (Facebook, LinkedIn, etc.)
OG_IMAGE=/static/images/og-image.png
OG_IMAGE_WIDTH=1200
OG_IMAGE_HEIGHT=630
OG_TYPE=website

# Twitter/X Card
TWITTER_CARD_TYPE=summary_large_image
TWITTER_SITE=@yourhandle
TWITTER_CREATOR=@yourhandle
TWITTER_IMAGE=/static/images/twitter-card.png

# Favicon Configuration
FAVICON_SVG=/static/images/favicon.svg
FAVICON_ICO=/static/images/favicon.ico
FAVICON_16=/static/images/favicon-16x16.png
FAVICON_32=/static/images/favicon-32x32.png
APPLE_TOUCH_ICON=/static/images/apple-touch-icon.png

# Application Logo
LOGO_PATH=/static/images/logo.png

# Theme Colors (hex format)
THEME_COLOR=#667eea
BACKGROUND_COLOR=#ffffff

# ============================================================================
# User Activity Monitoring and Analytics (Requirements: 8.1-8.6)
# ============================================================================
# Analytics Configuration
ENABLE_ANALYTICS=true                  # Enable/disable activity tracking
ANALYTICS_STORAGE_PATH=./analytics     # Directory for storing activity logs
ANALYTICS_RETENTION_DAYS=90            # Data retention period in days

# Admin Configuration
# Set admin user emails (comma-separated) for analytics dashboard access
ADMIN_EMAILS=admin@example.com,manager@example.com

# Privacy Settings
ANALYTICS_HASH_USER_IDS=true           # Hash user identifiers for privacy
ANALYTICS_HASH_IP_ADDRESSES=true       # Hash IP addresses for privacy
ANALYTICS_LOG_MESSAGE_CONTENT=false    # NEVER log message content (privacy)
